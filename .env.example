# ==============================================================================
# CoreSense Platform Environment Configuration
# Copy this file to `.env` in the workspace root (NEVER commit `.env`)
# ==============================================================================

# Server
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:5175,http://localhost:8081,http://localhost:1420,tauri://localhost,http://tauri.localhost

# Security Secrets (CHANGE IN PRODUCTION — 32+ bytes random hex)
JWT_SECRET=coresense-dev-customer-jwt-secret-change-in-production-64bytes
OWNER_JWT_SECRET=coresense-dev-owner-jwt-secret-completely-separate-64bytes
ENCRYPTION_KEY=coresense-dev-aes256-encryption-key-32bytes-minimum!!

# Supabase Production Auth + PostgreSQL (Session Pooler URI recommended for Render/Railway)
# When DATABASE_URL is unset, CoreSense falls back to isolated local SQLite files in DATA_DIR
DATA_DIR=./apps/api/data
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=

# Initial Private Owner Console Admin (bootstrapped on first run if no owner admin exists)
OWNER_INITIAL_EMAIL=owner@coresense.app
OWNER_INITIAL_PASSWORD=CoreSenseOwner#2026!

# AI Providers (Optional — CoreSense works offline with its Local Diagnostic Engine when unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_VISION_MODEL=gemini-4-hydrogen
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Optional OpenAI / OpenAI-compatible provider (or local Ollama via OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Public URLs
PUBLIC_API_URL=http://127.0.0.1:4000
