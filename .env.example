# ==============================================================================
# CoreSense Platform Environment Configuration
# Copy this file to `.env` in the workspace root or `apps/api/.env`
# ==============================================================================

# Server
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:5175,http://localhost:8081,http://localhost:1420,tauri://localhost,http://tauri.localhost

# Security Secrets (CHANGE IN PRODUCTION — 32+ bytes random hex)
JWT_SECRET=coresense-dev-customer-jwt-secret-change-in-production-64bytes
OWNER_JWT_SECRET=coresense-dev-owner-jwt-secret-completely-separate-64bytes
ENCRYPTION_KEY=coresense-dev-aes256-encryption-key-32bytes-minimum!!

# Database Storage
# Local/self-hosted uses two physically isolated SQLite databases (Customer vs Owner)
DATA_DIR=./apps/api/data
# Optional PostgreSQL production connection strings (separate databases/schemas recommended)
# CUSTOMER_DATABASE_URL=postgres://user:pass@host:5432/coresense_customer
# OWNER_DATABASE_URL=postgres://user:pass@host:5432/coresense_owner

# Initial Private Owner Console Admin (bootstrapped on first run if no owner admin exists)
OWNER_INITIAL_EMAIL=owner@coresense.app
OWNER_INITIAL_PASSWORD=CoreSenseOwner#2026!

# AI Providers (Optional — CoreSense works offline with its Local Diagnostic Engine when unset)
# Set GEMINI_API_KEY to unlock live Gemini 4 multimodal vision, reasoning, and embeddings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_VISION_MODEL=gemini-4-hydrogen
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Optional OpenAI / OpenAI-compatible provider (or local Ollama via OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Optional Stripe Billing Integration (Test/Live keys; billing works in local sandbox mode when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PREMIUM_MONTHLY=

# App URLs (for CORS, Stripe redirects, update manifests)
PUBLIC_API_URL=http://127.0.0.1:4000
DESKTOP_APP_URL=http://localhost:5173
OWNER_CONSOLE_URL=http://localhost:5175
